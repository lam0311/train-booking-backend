PORT=5000
HOSTNAME=localhost
# Chuoi ket noi MongoDB Atlas
# Lay tai: Atlas Console -> Database -> Connect -> Drivers -> Node.js
# Dinh dang: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL=?

# So luong connection toi da trong pool (nen dat 20-30 voi free tier)
# Moi request den server se muon 1 connection tu pool nay de query MongoDB
DB_MAX_POOL=20

# So luong connection toi thieu giu san trong pool (nen de 2)
DB_MIN_POOL=2

# Khoa bi mat de ky va xac thuc Access Token
# Dat chuoi ngau nhien dai >= 32 ky tu
JWT_ACCESS_SECRET=?

# Khoa bi mat rieng biet de ky va xac thuc Refresh Token
JWT_REFRESH_SECRET=?

# Thoi gian song cua Access Token
JWT_ACCESS_EXPIRES=15m

# Thoi gian song cua Refresh Token
JWT_REFRESH_EXPIRES=7d

# Chuoi ket noi Redis tren Upstash
# Lay tai: upstash.com -> Database -> Connect -> ioredis -> copy URL
# Dinh dang: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=?