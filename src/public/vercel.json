{
  "redirects": [
    {
      "source": "/api-docs",
      "destination": "/api-docs/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api-docs/",
      "destination": "https://train-booking-backend-3ri7.onrender.com/api-docs/"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "https://train-booking-backend-3ri7.onrender.com/api-docs/:path*"
    },
    {
      "source": "/swagger-ui(.*)",
      "destination": "https://train-booking-backend-3ri7.onrender.com/api-docs/swagger-ui$1"
    },
    {
      "source": "/favicon-:size*.png",
      "destination": "https://train-booking-backend-3ri7.onrender.com/api-docs/favicon-:size*.png"
    },
    {
      "source": "/openapi.json",
      "destination": "https://train-booking-backend-3ri7.onrender.com/openapi.json"
    },
    {
      "source": "/api/:match*",
      "destination": "https://train-booking-backend-3ri7.onrender.com/api/:match*"
    },
    {
      "source": "/health/:match*",
      "destination": "https://train-booking-backend-3ri7.onrender.com/health/:match*"
    }
  ]
}
